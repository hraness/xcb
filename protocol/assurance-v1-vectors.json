          "commandId": "cmd_gold_02",
          "target": "task.fixture",
          "command": "task/accept",
          "arguments": {"seed": 2},
          "expectedRevision": 0,
          "idempotencyKey": "idem_gold_02"
        }
      ],
      "expectedStatuses": ["settled", "replayed"],
      "expectedRevisions": [1, 1]
    },
    {
      "name": "revision-conflict",
      "commands": [
        {
          "commandId": "cmd_gold_03",
