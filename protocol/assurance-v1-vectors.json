        },
        {
          "commandId": "cmd_gold_04",
          "target": "task.fixture",
          "command": "task/accept",
          "arguments": {"seed": 4},
          "expectedRevision": 0,
          "idempotencyKey": "idem_gold_04"
        }
      ],
      "expectedStatuses": ["settled", "replayed"],
      "expectedRevisions": [1, 1]
    }
  ],
