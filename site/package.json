{
  "name": "xcb-site",
  "version": "0.4.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:theme": "bun scripts/check-paper-theme.mjs",
    "build:theme": "bun scripts/build-theme-bootstrap.ts",
    "sync:readme": "bun scripts/sync-readme.ts",
    "dev": "bun run sync:readme && bun run build:theme && next dev --webpack",
    "prebuild": "bun run sync:readme && bun run build:theme",
    "build": "next build --webpack",
    "postbuild": "bun test ./tests/runtime.test.ts",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "test": "bun test ./tests/source.test.ts ./tests/home.test.tsx ./tests/docs.test.tsx ./tests/compare.test.tsx ./scripts/readme-html.test.ts ./tests/ui-styles.test.tsx",
    "typecheck": "tsc --noEmit",
    "check": "bun run check:theme && bun run sync:readme && bun run build:theme && bun run test && bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#b0326108cf58268827ee69007414188ee27e2963",
    "@hraness/site-footer": "github:hraness/site-footer#v0.15.0",
    "@hraness/ui": "github:hraness/ui#c6b824c3ebcb95ba804f98076639946d03759a21",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.6.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "postcss": "8.5.28"
  },
  "type": "module"
}
