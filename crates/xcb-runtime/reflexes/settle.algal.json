              ],
              "acc",
              "t",
              [
                "add",
                [
                  "get",
                  "acc"
                ],
                [
                  "mul",
                  [
                    "get",
                    "t",
                    "w"
                  ],
                  [
                    "let",
                    "v",
                    [
                      "get",
                      "features",
                      [
                        "get",
