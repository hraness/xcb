{
  "name": "@hraness/xcb",
  "version": "0.8.9",
  "description": "TypeScript SDK and compatibility CLI for xcb, which routes coding tasks across the Claude, Codex, and Devin subscriptions you already pay for.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/xcb.git"
  },
  "homepage": "https://xcb.sh",
  "bugs": {
    "url": "https://github.com/hraness/xcb/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "xcb-compat": "dist/cli.js"
  },
  "files": [
    "dist",
    "MANAGED-CODEX.md",
    "sandbox"
  ],
  "scripts": {
    "build:dist": "bun scripts/build-dist.ts",
    "check:package": "bun scripts/package-smoke.ts",
    "test": "bun test ./src ./test ./scripts",
    "gobstopper-editor": "bun src/gobstopper-editor.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:versions": "bun scripts/release-version-contract.ts",
    "check": "bun run check:versions && bun run typecheck && bun run check:convex && bun run test && bun run build:dist && bun run check:package",
    "prepack": "bun run check",
    "convex:init": "bun scripts/convex-local.ts init",
    "convex:dev": "bun scripts/convex-local.ts dev --tail-logs disable",
    "convex:codegen": "bun scripts/convex-local.ts dev --once --tail-logs disable",
    "check:convex": "tsc -p convex/tsconfig.json && bun test ./convex"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@anthropic-ai/sdk": "0.127.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@convex-dev/auth": "0.0.95",
    "@hraness/relay": "github:hraness/relay#63026d60ad047e98947b4d909d006a13eb0c19b1",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "convex": "1.45.0",
    "convex-test": "0.0.59",
    "sigstore": "5.0.0",
    "typescript": "7.0.2"
  }
}
