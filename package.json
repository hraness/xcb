{
  "name": "@hraness/xcb",
  "version": "0.7.0",
  "description": "TypeScript SDK and compatibility CLI for Excalibur (xcb), which routes coding tasks across your Claude, Codex, and Devin subscriptions.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/xcb.git"
  },
  "homepage": "https://xcb.sh",
  "bugs": {
    "url": "https://github.com/hraness/xcb/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "xcb-compat": "dist/cli.js"
  },
  "files": [
    "dist",
    "MANAGED-CODEX.md",
    "sandbox"
  ],
  "scripts": {
    "build:dist": "bun scripts/build-dist.ts",
    "check:package": "bun scripts/package-smoke.ts",
    "test": "bun test ./src ./test ./scripts",
    "gobstopper-editor": "bun src/gobstopper-editor.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:versions": "bun scripts/release-version-contract.ts",
    "check": "bun run check:versions && bun run typecheck && bun run test && bun run build:dist && bun run check:package",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.268",
    "@anthropic-ai/sdk": "0.127.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "sigstore": "4.1.1",
    "typescript": "6.0.3"
  }
}
